// Datasource and generator only.
//
// Models live in per-domain files in this directory (identity, family, profiles,
// operations, ...). Prisma treats every .prisma file here as one schema, so
// splitting costs nothing at runtime and keeps unrelated domains out of each
// other's diffs.

generator client {
  provider     = "prisma-client"
  output       = "../generated"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}
