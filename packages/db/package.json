{
  "name": "@bumpatlas/db",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./types": {
      "default": "./src/types.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "postinstall": "prisma generate",
    "db:studio": "prisma studio",
    "seed:content": "node --env-file=../../apps/server/.env --import tsx seed/seed.ts",
    "seed:validate": "node --env-file=../../apps/server/.env --import tsx seed/validate.ts",
    "seed:demo": "node --env-file=../../apps/server/.env --import tsx seed/demo.ts",
    "seed:user": "node --env-file=../../apps/server/.env --import tsx seed/attach-user.ts"
  },
  "dependencies": {
    "@bumpatlas/env": "workspace:*",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "dotenv": "catalog:",
    "pg": "^8.17.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@bumpatlas/config": "workspace:*",
    "@types/pg": "^8.16.0",
    "prisma": "^7.8.0",
    "typescript": "catalog:",
    "tsx": "^4.20.5"
  }
}
