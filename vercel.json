{
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm -F server build",
  "outputDirectory": "apps/server/dist",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.mjs"
    }
  ]
}
